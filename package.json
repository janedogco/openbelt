{
  "name": "openbelt",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "workspace": "bun scripts/workspace.ts",
    "providers": "bun scripts/providers.ts",
    "seed": "bun scripts/seed.ts",
    "qa": "bun scripts/seed.ts as",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc -b --force",
    "guard": "bun scripts/guard.ts",
    "deadcode": "fallow dead-code --quiet --fail-on-issues",
    "check": "bun scripts/check.ts",
    "secrets": "bun scripts/secrets.ts",
    "cli:dist": "bun scripts/cli-dist.ts",
    "brand": "bun scripts/brand.ts",
    "prepare": "bun scripts/prepare.ts",
    "setup:check": "bun scripts/setup-check.ts",
    "fix": "oxlint --type-aware --fix; oxfmt",
    "tailnet": "bun scripts/tailnet.ts",
    "data": "bun scripts/data.ts",
    "www": "bun x serve www -l 4321",
    "grafana": "bun scripts/grafana.ts"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@grafana/grafana-foundation-sdk": "0.0.22",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "1.4.2",
    "agent-browser": "0.38.2",
    "effect": "4.0.5",
    "fallow": "3.42.0",
    "lefthook": "2.2.2",
    "matter-js": "0.19.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "three": "0.150.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
